# .env.local

# This variable tells our AI service which provider to use.
# 'ollama' -> Use the local Ollama service running in Docker.
# 'google' -> Use the Google AI service.
AI_PROVIDER=google

# Set this to 'true' to bypass the AI service entirely and return a simple mock image.
# Useful for frontend testing without running the AI.
MOCK_API_UPLOAD=false

# Google AI API Key (required when AI_PROVIDER=google)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=AIzaSyCR_VFixkaMSJf8gFci8FDvpXy2vZcWtxs

# OLLAMA_MODEL
# Optional: Specifies which model to use when AI_PROVIDER is 'ollama'.
# Defaults to 'llava'. Make sure you have pulled the model you specify.
# Example: OLLAMA_MODEL=llava
#OLLAMA_MODEL=llava