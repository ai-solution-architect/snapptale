# Snapptale Environment Variables
# ----------------------------------
# Copy this file to .env.local and fill in the values for your setup.

# AI_PROVIDER
# Specifies the AI provider to use for story generation.
# Options: 'ollama' (default) or 'google'.
# AI_PROVIDER=ollama

# GOOGLE_API_KEY
# Required if you set AI_PROVIDER to 'google'.
# Get your key from Google AI Studio: https://aistudio.google.com/
# GOOGLE_API_KEY=

# OLLAMA_MODEL
# Optional: Specifies which model to use when AI_PROVIDER is 'ollama'.
# Defaults to 'llava'. Make sure you have pulled the model you specify.
# Example: OLLAMA_MODEL=gemma:3b
# OLLAMA_MODEL=
